-- ⚙ 4. ระบบติดตาม UI
local trackedUI = {}

local function trackElement(obj)
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then return end
    if obj:GetAttribute("Cupcake_Tracked") then return end
    
    obj:SetAttribute("Cupcake_Tracked", true)
    table.insert(trackedUI, obj)

    if obj:IsA("TextBox") then
        obj:GetPropertyChangedSignal("PlaceholderText"):Connect(function()
            local pt = obj.PlaceholderText
            if pt and pt ~= "" then
                local clean = pt:gsub("<[^>]+>", ""):match("^%s*(.-)%s*$"):lower()
                if dict[clean] then
                    obj.PlaceholderText = dict[clean]
                end
            end
        end)
    end
end

local function scanRoots()
    local roots = {GuiService, CoreGui}
    if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
        table.insert(roots, LocalPlayer.PlayerGui)
    end
    
    for _, root in ipairs(roots) do
        for _, child in ipairs(root:GetDescendants()) do
            trackElement(child)
        end
        root.DescendantAdded:Connect(trackElement)
    end
end
scanRoots()

-- ⚙️ 5. ฟังก์ชันแปลภาษา
local function fastTranslate(obj)
    local t = obj.Text
    if not t or t == "" then return end
    if obj:GetAttribute("Translating") then return end

    local newT = t
    local changed = false

    -- [ระบบดักจับ Dropdown และเมนูย่อย]
    if t:find("^%s*>[^%w]*") then
        local base = t:gsub("^%s*>[^%w]*", ""):gsub("<[^>]+>", ""):match("^%s*(.-)%s*$"):lower()
        
        if base:find("dr scramble") then newT = "> ห้องแล็บ Dr Scramble & หุ่นรบ"; changed = true
        elseif base:find("butterfly bloom") then newT = "> ผีเสื้อเบ่งบาน (Butterfly Bloom)"; changed = true
        elseif base:find("wisp companion") then newT = "> สัตว์เลี้ยงวิญญาณ (Wisp)"; changed = true
        elseif base:find("auto steal") then newT = "> ออโต้ขโมยไข่"; changed = true
        elseif base:find("auto place egg") then newT = "> ออโต้วางไข่"; changed = true
        elseif base:find("auto treadmill") then newT = "> ออโต้วิ่งลู่วิ่ง"; changed = true
        elseif base:find("auto hatch") then newT = "> ออโต้ฟักและสวมใส่"; changed = true
        elseif base:find("auto sell lab egg") then newT = "> ออโต้ขายไข่แล็บ"; changed = true
        elseif base:find("auto sell") then newT = "> ออโต้ขายไข่ / สัตว์"; changed = true
        elseif base:find("auto fuse") then newT = "> ออโต้ผสมสัตว์ (Fuse Machine)"; changed = true
        elseif base:find("auto favorite") then newT = "> ออโต้ล็อกหัวใจ"; changed = true
        elseif base:find("priority") then newT = "> ลำดับการทำงาน (Priority)"; changed = true
        elseif base:find("character") then newT = "> ตัวละคร (Character)"; changed = true
        elseif base:find("combat") then newT = "> การต่อสู้ (Combat)"; changed = true
        elseif base:find("esp") then newT = "> มองทะลุ (ESP)"; changed = true
        elseif base:find("egg finder") then newT = "> ค้นหาไข่ (Egg Finder)"; changed = true
        elseif base:find("auto progression") then newT = "> ออโต้ความคืบหน้า"; changed = true
        elseif base:find("discord webhook") then newT = "> ดิสคอร์ดเว็บฮุก"; changed = true
        elseif base:find("egg predictor") then newT = "> พยากรณ์ไข่ (Egg Predictor)"; changed = true
        elseif base:find("lab predictor") then newT = "> พยากรณ์ห้องแล็บ (Lab Predictor)"; changed = true
        elseif base:find("fuse predictor") then newT = "> พยากรณ์การผสม (Fuse Predictor)"; changed = true
        end
    
    -- [เปลี่ยนชื่อสคริปต์ Chilli Hub เป็น คัฟเค้กv1 🐼🐻‍❄️]
    elseif (t == "Chilli Hub" or t:find("Chilli Hub")) and not t:find("คัฟเค้กv1") then 
        newT = "คัฟเค้กv1 🐼🐻‍❄️ (byคัฟเค้ก)"
        obj.TextColor3 = Color3.fromRGB(255, 255, 255)
        changed = true

    -- [จัดการป้ายสถานะ]
    elseif t == "Collect" then newT = "เก็บ"; changed = true
    elseif t == "Sort: Luck" then newT = "เรียง: โชค"; changed = true
    elseif t == "Auto: OFF" then newT = "ออโต้: ปิด"; changed = true
    elseif t == "Auto: ON" then newT = "ออโต้: เปิด"; changed = true
    elseif t == "Players 7/7" then newT = "ผู้เล่น 7/7"; changed = true
    elseif t == "Favorite" then newT = "ล็อกหัวใจ"; changed = true
    elseif t == "Sell" then newT = "ขาย"; changed = true
    elseif t == "Add" then newT = "เพิ่ม"; changed = true
    elseif t == "Reset" then newT = "รีเซ็ต"; changed = true
    elseif t == "Unfavorite" then newT = "ปลดล็อก"; changed = true
    
    -- [ค้นหาจาก Dictionary]
    else
        local clean = t:gsub("<[^>]+>", ""):match("^%s*(.-)%s*$")
        if clean then
            local lower = clean:lower()
            if dict[lower] then
                newT = dict[lower]
                changed = true
            end
        end
    end

    if changed then
        obj:SetAttribute("Translating", true)
        obj.Text = newT
        obj:SetAttribute("Translating", nil)
    end
end

