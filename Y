local RenderEvent = RunService.RenderStepped
if not RenderEvent then RenderEvent = RunService.Heartbeat end

RenderEvent:Connect(function()
    for i = #trackedUI, 1, -1 do
        local obj = trackedUI[i]
        if obj and obj.Parent then
            fastTranslate(obj)
        else
            table.remove(trackedUI, i)
        end
    end
end)

